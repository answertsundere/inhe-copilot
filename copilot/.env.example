# INHE 客服 Copilot 环境配置
# 复制为 .env 并填入真实值: cp .env.example .env
# ⚠️ .env 文件已被 .gitignore 排除，不会被提交到版本库

# ---- LLM 配置 ----
COPILOT_LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
COPILOT_LLM_API_KEY=
COPILOT_LLM_MODEL=qwen-plus

# ---- 客户图片 VLM 配置（OpenAI-compatible）----
COPILOT_VLM_ENABLED=false
COPILOT_VLM_API_BASE=
COPILOT_VLM_API_KEY=
COPILOT_VLM_MODEL=
COPILOT_VLM_TIMEOUT_SECONDS=30

# ---- 聚水潭 API 配置 ----
JUSHUITAN_APP_KEY=
JUSHUITAN_APP_SECRET=
JUSHUITAN_ACCESS_TOKEN=
JUSHUITAN_BASE_URL=https://openapi.jushuitan.com/open

# ---- 数据目录 ----
COPILOT_EXTERNAL_DATA_DIR=

# ---- Web 服务 ----
COPILOT_WEB_HOST=127.0.0.1
COPILOT_WEB_PORT=5000
COPILOT_WEB_DEBUG=false

# ---- 日志 ----
COPILOT_LOG_LEVEL=INFO

# ---- 钉钉多维表配置 (可选) ----
COPILOT_DT_CLIENT_ID=
COPILOT_DT_CLIENT_SECRET=
COPILOT_DT_OPERATOR_ID=
COPILOT_DT_BASE_ID=

# ---- Embedding 配置 (可选, 默认关闭) ----
COPILOT_EMBEDDING_ENABLED=false
# Copy this file to .env and fill real values locally.
# Never commit .env/.env.local. API keys must stay on the local machine.
COPILOT_EMBEDDING_MODEL=text-embedding-v3
COPILOT_EMBEDDING_API_BASE=<your_embedding_api_base>
COPILOT_EMBEDDING_API_KEY=<your_embedding_api_key>
COPILOT_RAG_VECTOR_WEIGHT=0.55
COPILOT_RAG_TEXT_WEIGHT=0.30
COPILOT_RAG_SCOPE_WEIGHT=0.15
