# INHE 客服 Copilot - .gitignore

# ============ 密钥与环境 (绝对不能提交) ============
.env
sidecar.env
copilot/sidecar.env
copilot/deploy/.env.production
*.env.local
.env.*.local

# ============ Python ============
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/

# ============ 虚拟环境 ============
venv/
.venv/
env/

# ============ IDE ============
.vscode/
.idea/
*.swp
*.swo
*~

# ============ 测试和缓存 ============
.pytest_cache/
htmlcov/
.coverage

